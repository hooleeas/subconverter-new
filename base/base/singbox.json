{
    "log": {
        "disabled": false,
        "level": "info",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "type": "tls",
                "tag": "dns_proxy",
                "server": "1.1.1.1"
            },
            {
                "type": "h3",
                "tag": "dns_direct",
                "server": "dns.alidns.com",
                "path": "/dns-query",
                "domain_resolver": {
                    "server": "dns_resolver"
                }
            },
            {
                "type": "fakeip",
                "tag": "dns_fakeip",
                "inet4_range": "198.18.0.0/15",
                "inet6_range": "fc00::/18"
            },
            {
                "type": "udp",
                "tag": "dns_resolver",
                "server": "223.5.5.5"
            }
        ],
        "rules": [],
        "final": "dns_direct",
        "reverse_mapping": true
    },
    "ntp": {
        "enabled": true,
        "server": "time.apple.com",
        "server_port": 123,
        "interval": "30m",
        "detour": "DIRECT"
    },
    "inbounds": [
        {
            "type": "mixed",
            "tag": "mixed-in",
            "listen": "0.0.0.0",
            "listen_port": 2080
        },
        {
            "type": "tun",
            "tag": "tun-in",
            "address": [
                "172.19.0.1/30",
                "fdfe:dcba:9876::1/126"
            ],
            "auto_route": true,
            "strict_route": true,
            "stack": "mixed",
            "sniff": true
        }
    ],
    "outbounds": [],
    "route": {
        "rules": [],
        "auto_detect_interface": true
    },
    "experimental": {
        "cache_file": {
            "enabled": true,
            "store_fakeip": true
        },
        "clash_api": {
            "external_controller": "127.0.0.1:9090",
            "external_ui": "dashboard"
        }
    }
}
